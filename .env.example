# ===============================
# SERVER
# ===============================
PORT=3005

# Public HTTPS URL of this app, no trailing slash.
# Must match the App URL in the Partner Dashboard exactly, and the redirect
# URL there must be exactly HOST + /api/auth/callback.
HOST=https://your-tunnel.example.com

# ===============================
# SHOPIFY
# ===============================
# Partner Dashboard > your app > Configuration > Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Admin API version used for GraphQL calls and webhook registration.
SHOPIFY_API_VERSION=2025-07

# Access scopes requested during OAuth. Changing this requires merchants to
# reinstall, so add a scope only when the feature that needs it is built.
# Common ones: read_products, write_products, read_orders, write_orders,
# read_customers (protected: request access in the Partner Dashboard first).
SHOPIFY_SCOPES=read_products

# Timeout for outbound Shopify calls, in milliseconds.
SHOPIFY_TIMEOUT_MS=15000

# ===============================
# ENCRYPTION
# ===============================
# 32 bytes, base64 or hex. Encrypts stores.access_token / refresh_token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored token undecryptable -- all stores must reinstall.
TOKEN_ENCRYPTION_KEY=

# ===============================
# DATABASE (MySQL)
# ===============================
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=shopify_app
DB_POOL_SIZE=10

# ===============================
# EMAIL (optional)
# ===============================
# services/mailer.js sends nothing unless SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Your App <no-reply@example.com>

# Shown as a "Contact support" button on the Help screen when set.
SUPPORT_EMAIL=
